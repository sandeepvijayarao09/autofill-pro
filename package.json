{
  "name": "autofill-pro",
  "version": "1.1.0",
  "description": "Browser extension that fills job applications. Matches 44 profile fields locally, tested against labels from 46 job sites and ATS platforms; optional AI (your own NVIDIA NIM key) for custom questions and resume import.",
  "type": "commonjs",
  "private": false,
  "license": "MIT",
  "author": "Sai Sandeep Kumar Vijayarao",
  "homepage": "https://github.com/sandeepvijayarao09/autofill-pro#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sandeepvijayarao09/autofill-pro.git"
  },
  "bugs": {
    "url": "https://github.com/sandeepvijayarao09/autofill-pro/issues"
  },
  "keywords": [
    "chrome-extension",
    "browser-extension",
    "manifest-v3",
    "autofill",
    "job-application",
    "ats",
    "form-filler",
    "privacy",
    "workday",
    "greenhouse",
    "lever"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node test.js && node --test 'test/*.test.js' 'test/*.test.mjs'",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "build": "node scripts/build.mjs",
    "icons": "node scripts/generate-icons.js",
    "vendor:pdfjs": "cp node_modules/pdfjs-dist/legacy/build/pdf.min.mjs node_modules/pdfjs-dist/legacy/build/pdf.worker.min.mjs node_modules/pdfjs-dist/LICENSE vendor/pdfjs/"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "canvas": "^3.2.3",
    "eslint": "^9.9.0",
    "globals": "^15.9.0",
    "pdfjs-dist": "^6.4.299"
  }
}
